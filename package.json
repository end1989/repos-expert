{
  "name": "repos-expert",
  "version": "0.1.1",
  "description": "Answers questions about a folder of code repositories — studies each one, writes a knowledge base, and serves it over MCP.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "expert": "dist/cli/index.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "documentation",
    "code-search",
    "knowledge-base"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "SETUP.md",
    "expert.config.example.json"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "dev": "tsx src/cli/index.ts",
    "prepublishOnly": "npm run build && npm run test"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.227",
    "@anthropic-ai/sdk": "^0.116.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@vscode/ripgrep": "^1.18.0",
    "commander": "^15.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
