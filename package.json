{
  "name": "repos-expert",
  "version": "0.1.14",
  "description": "Answers questions about a folder of code repositories — studies each one, writes a knowledge base, and serves it over MCP.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/end1989/repos-expert.git"
  },
  "homepage": "https://github.com/end1989/repos-expert#readme",
  "bugs": {
    "url": "https://github.com/end1989/repos-expert/issues"
  },
  "type": "module",
  "bin": {
    "expert": "dist/cli/index.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "documentation",
    "code-search",
    "knowledge-base"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist",
    "README.md",
    "SETUP.md",
    "CHANGELOG.md",
    "expert.config.example.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "lint": "oxlint --type-aware --deny-warnings src tests evals",
    "format": "prettier --write \"**/*.{ts,mjs,js,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,mjs,js,json,yml,yaml}\"",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:coverage": "npm run build && vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "dev": "tsx src/cli/index.ts",
    "prepublishOnly": "npm run check",
    "eval": "tsx evals/run.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.327",
    "@anthropic-ai/sdk": "^1.8.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@vscode/ripgrep": "^1.18.0",
    "commander": "^15.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^4.1.12",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "prettier": "^3.10.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
